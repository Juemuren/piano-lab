{
  "name": "piano-lab",
  "private": true,
  "version": "1.6.0",
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "tsc --build && vite build",
    "build:tauri": "tauri build --no-bundle",
    "tauri": "tauri",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "typecheck": "tsc --build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "biome check --write --no-errors-on-unmatched",
    "*.{css,html,json}": "biome format --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "abcjs": "^6.6.2",
    "i18next": "^26.3.6",
    "katex": "^0.17.0",
    "lucide-react": "^1.28.0",
    "plotly.js": "^3.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-katex": "^3.1.0",
    "react-plotly.js": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.12.2",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-katex": "^3.0.4",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.0"
  }
}
