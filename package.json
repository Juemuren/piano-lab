{
  "name": "piano-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "tsc -b && vite build",
    "build:tauri": "tauri build --no-bundle",
    "tauri": "tauri",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "preview": "vite preview",
    "set:version": "node scripts/set-version.mjs",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "biome check --write",
    "*.{css,html,json}": "biome format --write"
  },
  "dependencies": {
    "abcjs": "^6.6.2",
    "i18next": "^26.2.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "plotly.js": "^3.5.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.8",
    "react-katex": "^3.1.0",
    "react-plotly.js": "^2.6.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-katex": "^3.0.4",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4"
  }
}
